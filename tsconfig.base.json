{
  "compileOnSave": false,
  "compilerOptions": {
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2022",
    "baseUrl": ".",
    "importHelpers": true,
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "esModuleInterop": true,
    "allowJs": false,
    "moduleDetection": "force",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "paths": {
      "@app/*": ["apps/api/src/*"],
      "@cthub-bsaas/server-contracts-auth": ["libs/server/contracts-auth/src/index.ts"],
      "@cthub-bsaas/server-contracts-auth/*": ["dist/libs/server/contracts-auth/*", "libs/server/contracts-auth/src/*"],
      "@cthub-bsaas/server-contracts-platform": ["libs/server/contracts-platform/src/index.ts"],
      "@cthub-bsaas/server-contracts-platform/*": ["dist/libs/server/contracts-platform/*", "libs/server/contracts-platform/src/*"],
      "@cthub-bsaas/server-core": ["libs/server/core/src/index.ts"],
      "@cthub-bsaas/server-core/*": ["dist/libs/server/core/*", "libs/server/core/src/*"],
      "@cthub-bsaas/server-data-access": ["libs/server/data-access/src/index.ts"],
      "@cthub-bsaas/server-data-access/*": ["dist/libs/server/data-access/*", "libs/server/data-access/src/*"],
      "@cthub-bsaas/server-feature-auth": ["libs/server/features/auth/src/index.ts"],
      "@cthub-bsaas/server-feature-auth/*": ["dist/libs/server/features/auth/*", "libs/server/features/auth/src/*"],
      "@cthub-bsaas/server-feature-salon-owner": ["libs/server/features/salon-owner/src/index.ts"],
      "@cthub-bsaas/server-infrastructure": ["libs/server/infrastructure/src/index.ts"],
      "@cthub-bsaas/server-infrastructure/*": ["dist/libs/server/infrastructure/*", "libs/server/infrastructure/src/*"],
      "@cthub-bsaas/server-testing-utils": ["libs/server/server-testing-utils/src/index.ts"],
      "@cthub-bsaas/server-testing-utils/*": ["dist/libs/server/server-testing-utils/*", "libs/server/server-testing-utils/src/*"],
      "@cthub-bsaas/shared": ["libs/shared/src/index.ts"],
      "@cthub-bsaas/shared/models/*": ["libs/shared/src/lib/models/*"],
      "@cthub-bsaas/shared/*": ["libs/shared/src/lib/*", "libs/shared/src/*", "dist/libs/shared/*"],
      "@cthub-bsaas/web-admin": ["libs/web/admin/src/index.ts"],
      "@cthub-bsaas/web-admin/*": ["libs/web/admin/src/*"],
      "@cthub-bsaas/web-admin/auth": ["libs/web/admin/src/lib/features/auth/index.ts"],
      "@cthub-bsaas/web-config": ["libs/web/config/src/index.ts"],
      "@cthub-bsaas/web-config/*": ["libs/web/config/src/*"],
      "@cthub-bsaas/web-config/environments/*": ["libs/web/config/src/environments/*"],
      "@cthub-bsaas/web-core-auth": ["libs/web/core/auth/src/index.ts"],
      "@cthub-bsaas/web-core-auth/*": ["libs/web/core/auth/src/*", "dist/libs/web/core/auth/*"],
      "@cthub-bsaas/web-core-common": ["libs/web/core/common/src/index.ts"],
      "@cthub-bsaas/web-core-common/*": ["libs/web/core/common/src/*", "dist/libs/web/core/common/*"],
      "@cthub-bsaas/web-core-http": ["libs/web/core/http/src/index.ts"],
      "@cthub-bsaas/web-core-http/*": ["libs/web/core/http/src/*", "dist/libs/web/core/http/*"],
      "@cthub-bsaas/web-core-platform": ["libs/web/core/platform/src/index.ts"],
      "@cthub-bsaas/web-core-platform/*": ["libs/web/core/platform/src/*", "dist/libs/web/core/platform/*"],
      "@cthub-bsaas/web-core-testing": ["libs/web/core/testing/src/index.ts"],
      "@cthub-bsaas/web-core-testing/*": ["libs/web/core/testing/src/*", "dist/libs/web/core/testing/*"],
      "@cthub-bsaas/web-customer": ["libs/web/customer/src/index.ts"],
      "@cthub-bsaas/web-customer/*": ["libs/web/customer/src/*"],
      "@cthub-bsaas/web-customer/auth": ["libs/web/customer/src/lib/features/auth/index.ts"],
      "@cthub-bsaas/web-partner": ["libs/web/partner/src/index.ts"],
      "@cthub-bsaas/web-partner/*": ["libs/web/partner/src/*"],
      "@cthub-bsaas/web-partner/auth": ["libs/web/partner/src/lib/features/auth/index.ts"],
      "@cthub-bsaas/web-public": ["libs/web/public/src/index.ts"],
      "@cthub-bsaas/web-ui": ["libs/web/ui/src/index.ts"],
      "@cthub-bsaas/web-ui/*": ["libs/web/ui/src/*", "dist/libs/web/ui/*"],
      "chart.js/dist/types/utils": ["node_modules/chart.js/dist/types/utils.d.ts"]
    },
    "types": ["node", "@angular/localize"],
    "experimentalDecorators": true,
    "sourceMap": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "noUncheckedSideEffectImports": false,
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "dist"],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
