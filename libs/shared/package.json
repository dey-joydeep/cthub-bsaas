{
  "name": "@cthub-bsaas/shared",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./enums/*": {
      "types": "./src/lib/enums/*.ts",
      "default": "./src/lib/enums/*.ts"
    },
    "./types/*": {
      "types": "./src/lib/types/*.ts",
      "default": "./src/lib/types/*.ts"
    },
    "./models/*": {
      "types": "./src/lib/models/*.ts",
      "default": "./src/lib/models/*.ts"
    },
    "./i18n-message-keys/*": {
      "types": "./src/lib/i18n-message-keys/*.ts",
      "default": "./src/lib/i18n-message-keys/*.ts"
    }
  },
  "sideEffects": false
}
