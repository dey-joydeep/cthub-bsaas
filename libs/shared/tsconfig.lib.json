{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/libs/shared",
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "rootDir": "./src",
    "isolatedModules": false,
    "useDefineForClassFields": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "**/*.test.ts"]
}
