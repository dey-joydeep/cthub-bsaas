{
  "name": "server-contracts-platform",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/contracts-platform/src",
  "projectType": "library",
  "tags": ["scope:server", "type:core", "layer:contracts"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/contracts-platform",
        "main": "libs/server/contracts-platform/src/index.ts",
        "tsConfig": "libs/server/contracts-platform/tsconfig.lib.json",
        "assets": ["libs/server/contracts-platform/*.md"],
        "rootDir": "libs/server/contracts-platform/src"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/server/contracts-platform/jest.config.ts"
      }
    }
  }
}
