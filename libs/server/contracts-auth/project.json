{
  "name": "server-contracts-auth",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/contracts-auth/src",
  "projectType": "library",
  "tags": ["type:lib", "platform:server", "scope:server", "layer:contracts"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/contracts-auth",
        "main": "libs/server/contracts-auth/src/index.ts",
        "tsConfig": "libs/server/contracts-auth/tsconfig.lib.json",
        "assets": ["libs/server/contracts-auth/*.md"],
        "rootDir": "libs/server/contracts-auth/src"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["shared:build"],
      "options": {
        "command": "tsc -b libs/server/contracts-auth/tsconfig.json --pretty false"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "executor": "@nx/jest:jest",
      "options": {
        "passWithNoTests": true,
        "jestConfig": "libs/server/contracts-auth/jest.config.ts",
        "codeCoverage": true,
        "coverageReporters": ["text", "lcov"]
      }
    }
  }
}
