{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../../dist/libs/server/contracts-auth",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "sourceMap": true,
    "isolatedModules": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "composite": true,
    "rootDir": "./src",
    "tsBuildInfoFile": "../../../dist/.tsbuildinfo/server/contracts-auth.tsbuildinfo",
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"],
  "references": [
    {
      "path": "../../shared/tsconfig.lib.json"
    }
  ]
}
