{
  "name": "server-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/data-access/src",
  "projectType": "library",
  "tags": ["type:lib", "platform:server", "scope:server-data", "scope:server", "type:data"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/data-access",
        "main": "libs/server/data-access/src/index.ts",
        "tsConfig": "libs/server/data-access/tsconfig.lib.json",
        "assets": ["libs/server/data-access/src/schema.prisma", "libs/server/data-access/src/migrations/**/*"],
        "updateBuildableProjectDepsInPackageJson": true,
        "buildableProjectDepsInPackageJsonType": "dependencies",
        "rootDir": "libs/server/data-access/src"
      },
      "configurations": {
        "production": {}
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["shared:build", "server-contracts-auth:build", "server-core:build"],
      "options": {
        "command": "tsc -b libs/server/data-access/tsconfig.json --pretty false"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
