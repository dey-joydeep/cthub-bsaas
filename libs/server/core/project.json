{
  "name": "server-core",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/core/src",
  "projectType": "library",
  "prefix": "cthub-bsaas",
  "tags": ["type:lib", "platform:server", "scope:server-core", "scope:server", "type:core"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/core",
        "main": "libs/server/core/src/index.ts",
        "tsConfig": "libs/server/core/tsconfig.lib.json",
        "assets": ["libs/server/core/*.md"],
        "rootDir": "libs/server/core/src"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["shared:build", "server-contracts-auth:build"],
      "options": {
        "command": "tsc -b libs/server/core/tsconfig.json --pretty false"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverageReporters": ["text", "lcov"],
        "coverage": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
