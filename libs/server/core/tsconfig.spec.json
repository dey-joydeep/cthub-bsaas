{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "outDir": "../../../dist/out-tsc",
        "module": "commonjs",
        "moduleResolution": "node",
        "types": ["jest", "node"],
        "esModuleInterop": true,
        "target": "es2022",
        "isolatedModules": true,
        "useDefineForClassFields": false
    },
    "include": ["src/testing/**/*.ts", "**/*.spec.ts", "**/*.test.ts", "**/*.d.ts", "**/*.fixture.ts"],
    "references": [
        {
            "path": "../contracts-auth/tsconfig.lib.json"
        }
    ]
}