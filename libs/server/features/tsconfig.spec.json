{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "isolatedModules": false,
    "useDefineForClassFields": false
