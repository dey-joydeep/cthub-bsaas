{
  "name": "server-feature-public-discovery",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/server/features/public-discovery/src",
  "projectType": "library",
  "tags": ["type:lib", "platform:server", "scope:server-feature", "scope:server", "type:feature"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/features/public-discovery",
        "tsConfig": "libs/server/features/public-discovery/tsconfig.lib.json",
        "packageJson": "libs/server/features/public-discovery/package.json",
        "main": "libs/server/features/public-discovery/src/index.ts",
        "assets": [],
        "buildableProjectDepsInPackageJsonType": "dependencies"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/server/features/public-discovery/tsconfig.lib.json"
        },
        "development": {
          "tsConfig": "libs/server/features/public-discovery/tsconfig.lib.json"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/server/features/public-discovery/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["shared:build", "server-core:build", "server-data-access:build"],
      "options": {
        "command": "tsc -b libs/server/features/public-discovery/tsconfig.json --pretty false"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/server/features/public-discovery/jest.config.ts",
        "passWithNoTests": true,
        "codeCoverage": true,
        "coverageReporters": ["text", "lcov"],
        "coverageDirectory": "coverage/libs/server/features/public-discovery"
      },
      "configurations": {
        "ut": {
          "jestConfig": "libs/server/features/public-discovery/jest.unit.config.ts"
        },
        "it": {
          "jestConfig": "libs/server/features/public-discovery/jest.int.config.ts"
        }
      }
    }
  }
}
