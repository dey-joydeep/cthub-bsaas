{
  "name": "server-feature-theme",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/server/features/theme/src",
  "prefix": "app",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/server/features/theme",
        "tsConfig": "libs/server/features/theme/tsconfig.lib.json",
        "packageJson": "libs/server/features/theme/package.json",
        "main": "libs/server/features/theme/src/index.ts",
        "assets": [],
        "buildableProjectDepsInPackageJsonType": "dependencies"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/server/features/theme/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/server/features/theme/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "shared:build",
        "server-contracts-auth:build",
        "server-core:build",
        "server-data-access:build",
        "server-infrastructure:build"
      ],
      "options": {
        "command": "tsc -b E:\\workspace\\cthub-bsaas\\libs\\server\\features\\theme/tsconfig.json --pretty false"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["libs/server/features/theme/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/server/features/theme/jest.config.ts",
        "passWithNoTests": true,
        "codeCoverage": true,
        "coverageReporters": ["text", "lcov"],
        "coverageDirectory": "coverage/libs/server/features/theme"
      },
      "configurations": {
        "ut": {
          "jestConfig": "libs/server/features/theme/jest.unit.config.ts"
        },
        "it": {
          "jestConfig": "libs/server/features/theme/jest.int.config.ts"
        }
      }
    },
    "deploy": {
      "executor": "@nx/workspace:run-commands",
      "options": {
        "command": "npm publish {projectRoot}/dist --access public",
        "parallel": true
      },
      "dependsOn": ["build"]
    }
  },
  "tags": ["type:lib", "platform:server", "scope:server-feature", "scope:server", "type:feature"],
  "implicitDependencies": ["server-core"],
  "dependencies": [
    {
      "target": "server-data-access",
      "projects": "server-data-access"
    }
  ]
}
