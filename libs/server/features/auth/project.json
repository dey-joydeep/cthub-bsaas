{
  "name": "server-feature-auth",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/server/features/auth/src",
  "prefix": "app",
  "tags": ["type:lib", "platform:server", "scope:server-feature", "scope:server", "type:feature"],
  "implicitDependencies": ["server-core", "server-data-access"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/libs/server/features/auth",
        "tsConfig": "libs/server/features/auth/tsconfig.lib.json",
        "packageJson": "libs/server/features/auth/package.json",
        "main": "libs/server/features/auth/src/index.ts",
        "assets": [],
        "buildableProjectDepsInPackageJsonType": "dependencies"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/server/features/auth/tsconfig.lib.prod.json"
        },
        "development": {
          "tsConfig": "libs/server/features/auth/tsconfig.lib.json"
        }
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "dependsOn": [
        "shared:build",
        "server-contracts-auth:build",
        "server-core:build",
        "server-data-access:build",
        "server-infrastructure:build"
      ],
      "options": {
        "command": "tsc -b libs/server/features/auth/tsconfig.json --pretty false"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true,
        "coverageReporters": ["text", "lcov"],
        "coverageDirectory": "../../../../coverage/libs/server/features/auth",
        "coverage": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        },
        "ut": {
          "config": "./jest.unit.config.ts"
        },
        "it": {
          "config": "./jest.int.config.ts"
        }
      }
    }
  }
}
