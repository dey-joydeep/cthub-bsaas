{
  "name": "web-lib-partner",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/partner/src",
  "prefix": "lib",
  "tags": ["platform:web", "scope:web", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/web/partner"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/partner/ng-package.json",
        "tsConfig": "libs/web/partner/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/partner/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint src/index.ts src/lib/features/auth/**/*.ts src/lib/features/auth/**/*.html"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/partner/tsconfig.lib.json --noEmit"
      }
    }
  }
}
