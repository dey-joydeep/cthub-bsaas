{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/web/partner",
    "paths": {
      "@cthub-bsaas/shared": ["dist/libs/shared"],
      "@cthub-bsaas/web-config": ["dist/libs/web/config"],
      "@cthub-bsaas/web-core-auth": ["dist/libs/web/core/auth"],
      "@cthub-bsaas/web-core/auth": ["dist/libs/web/core/auth"],
      "@cthub-bsaas/web-core-common": ["dist/libs/web/core/common"],
      "@cthub-bsaas/web-core-platform": ["dist/libs/web/core/platform"],
      "@cthub-bsaas/web-ui": ["dist/libs/web/ui"]
    },
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src/index.ts", "src/lib/features/auth/**/*.ts", "src/**/*.d.ts"],
  "exclude": [
    "src/test-setup.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "jest.config.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ]
}
