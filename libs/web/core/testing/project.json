{
  "name": "web-core-testing",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/testing/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["platform:web", "scope:web-core", "type:lib"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["src/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/testing/tsconfig.spec.json --noEmit"
      }
    }
  }
}
