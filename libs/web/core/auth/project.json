{
  "name": "web-core-auth",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/auth/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["platform:web", "scope:web-core", "type:data", "type:lib"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/core/auth/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/web/core/auth/src/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/auth/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "outputs": ["{workspaceRoot}/dist/libs/web/core/auth"],
      "executor": "@nx/angular:package",
      "options": {
        "tsConfig": "libs/web/core/auth/tsconfig.lib.json",
        "project": "libs/web/core/auth/ng-package.json"
      },
      "dependsOn": ["^build"]
    }
  }
}
