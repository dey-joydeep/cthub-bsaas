{
  "name": "web-core-auth",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/auth/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": [
    "platform:web",
    "scope:web-core",
    "type:data",
    "type:lib"
  ],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/web/core/auth/src/**/*.ts"
        ]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/auth/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "outputs": [
        "{workspaceRoot}/dist/libs/web/core/auth"
      ],
      "executor": "@nx/angular:package",
      "dependsOn": [
        "^build"
      ],
      "options": {
        "tsConfig": "libs/web/core/auth/tsconfig.lib.json",
        "project": "libs/web/core/auth/ng-package.json"
      }
    }
  }
}