{
  "name": "web-core-common",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/common/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["platform:web", "scope:web-core", "type:core", "type:lib"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/core/common/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/web/core/common/src/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/common/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/web/core/common"],
      "options": {
        "project": "libs/web/core/common/ng-package.json",
        "tsConfig": "libs/web/core/common/tsconfig.lib.json"
      },
      "dependsOn": ["^build"]
    }
  }
}
