{
  "name": "web-core-common",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/common/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["platform:web", "scope:web-core", "type:core", "type:lib"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["src/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/common/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/web/core/common"],
      "dependsOn": ["^build"],
      "options": {
        "project": "libs/web/core/common/ng-package.json",
        "tsConfig": "libs/web/core/common/tsconfig.lib.json"
      }
    }
  }
}
