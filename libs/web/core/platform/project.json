{
  "name": "web-core-platform",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/web/core/platform/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["platform:web", "scope:web-core", "type:core", "type:lib"],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/web/core/platform/jest.config.ts",
        "tsConfig": "libs/web/core/platform/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["libs/web/core/platform/src/**/*.ts"]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/core/platform/tsconfig.spec.json --noEmit"
      }
    },
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/web/core/platform"],
      "dependsOn": ["^build"],
      "options": {
        "project": "libs/web/core/platform/ng-package.json",
        "tsConfig": "libs/web/core/platform/tsconfig.lib.json"
      }
    }
  }
}
