{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/web/public",
    "paths": {
      "@cthub-bsaas/shared": ["dist/libs/shared", "libs/shared/src/index.ts"],
      "@cthub-bsaas/web-config": ["dist/libs/web/config", "libs/web/config/src/index.ts"],
      "@cthub-bsaas/web-core-common": ["dist/libs/web/core/common", "libs/web/core/common/src/index.ts"],
      "@cthub-bsaas/web-core-platform": ["dist/libs/web/core/platform", "libs/web/core/platform/src/index.ts"],
      "@cthub-bsaas/web-ui": ["dist/libs/web/ui", "libs/web/ui/src/index.ts"]
    },
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["src/index.ts", "src/lib/public.routes.ts", "src/**/*.d.ts"],
  "exclude": [
    "src/test-setup.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "jest.config.ts",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-setup.ts"
  ]
}
