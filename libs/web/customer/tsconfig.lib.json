{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/web/customer",
    "paths": {
      "@cthub-bsaas/shared": ["dist/libs/shared/index.d.ts"],
      "@cthub-bsaas/web-config": ["dist/libs/web/config/index.d.ts"],
      "@cthub-bsaas/web-core-auth": ["dist/libs/web/core/auth/index.d.ts"],
      "@cthub-bsaas/web-core/auth": ["dist/libs/web/core/auth/index.d.ts"],
      "@cthub-bsaas/web-core-common": ["dist/libs/web/core/common/index.d.ts"],
      "@cthub-bsaas/web-core-platform": ["dist/libs/web/core/platform/index.d.ts"],
      "@cthub-bsaas/web-ui": ["dist/libs/web/ui/index.d.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/lib/customer.routes.ts",
    "src/lib/features/auth/**/*.ts",
    "src/lib/features/customer-app/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": ["src/test-setup.ts", "**/*.spec.ts", "**/*.test.ts", "jest.config.ts"]
}
