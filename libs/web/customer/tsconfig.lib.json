{
  "extends": "../tsconfig.lib.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "../../../dist/out-tsc/libs/web/customer",
    "paths": {
      "@cthub-bsaas/shared": ["libs/shared/src/index.ts"],
      "@cthub-bsaas/web-config": ["libs/web/config/src/index.ts"],
      "@cthub-bsaas/web-core-auth": ["libs/web/core/auth/src/index.ts"],
      "@cthub-bsaas/web-core/auth": ["libs/web/core/auth/src/index.ts"],
      "@cthub-bsaas/web-core-common": ["libs/web/core/common/src/index.ts"],
      "@cthub-bsaas/web-core-platform": ["libs/web/core/platform/src/index.ts"],
      "@cthub-bsaas/web-ui": ["libs/web/ui/src/index.ts"]
    }
  },
  "include": ["src/index.ts", "src/lib/features/auth/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["src/test-setup.ts", "**/*.spec.ts", "**/*.test.ts", "jest.config.ts"]
}
