{
  "name": "web-lib-customer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/customer/src",
  "prefix": "lib",
  "tags": [
    "platform:web",
    "scope:web",
    "type:lib"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/libs/web/customer"
      ],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/customer/ng-package.json",
        "tsConfig": "libs/web/customer/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/customer/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/web/customer/src/index.ts",
          "libs/web/customer/src/lib/features/auth/**/*.ts",
          "libs/web/customer/src/lib/features/auth/**/*.html",
          "libs/web/customer/src/lib/features/auth/**/*.css"
        ]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/customer/tsconfig.lib.json --noEmit"
      }
    }
  }
}