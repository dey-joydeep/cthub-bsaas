{
  "name": "web-lib-admin",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/web/admin/src",
  "prefix": "lib",
  "tags": ["platform:web", "scope:web", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": ["{workspaceRoot}/dist/libs/web/admin"],
      "defaultConfiguration": "production",
      "options": {
        "project": "libs/web/admin/ng-package.json",
        "tsConfig": "libs/web/admin/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/web/admin/tsconfig.lib.prod.json"
        },
        "development": {}
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/libs/web/admin"],
      "options": {
        "jestConfig": "libs/web/admin/jest.config.ts",
        "tsConfig": "libs/web/admin/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/web/admin/src/index.ts",
          "libs/web/admin/src/lib/features/auth/**/*.ts",
          "libs/web/admin/src/lib/features/auth/**/*.html",
          "libs/web/admin/src/lib/features/auth/**/*.scss"
        ]
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/web/admin/tsconfig.lib.json --noEmit"
      }
    }
  }
}
