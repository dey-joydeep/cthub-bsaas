{
  "name": "cthub-bsaas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web/admin",
    "apps/web/customer",
    "apps/web/partner",
    "libs/server/core",
    "libs/server/data-access",
    "libs/server/contracts-auth",
    "libs/server/contracts-platform",
    "libs/server/features/auth",
    "libs/server/infrastructure",
    "libs/shared",
    "libs/web/admin",
    "libs/web/config",
    "libs/web/core/common",
    "libs/web/core/auth",
    "libs/web/core/http",
    "libs/web/core/platform",
    "libs/web/core/testing",
    "libs/web/customer",
    "libs/web/partner",
    "libs/web/public",
    "libs/web/ui"
  ],
  "scripts": {
    "postinstall": "node scripts/check-versions/node-version.js",
    "dev:web-admin": "nx serve web-app-admin",
    "dev:web-customer": "nx serve web-app-customer",
    "dev:web-partner": "nx serve web-app-partner",
    "dev:api": "nx serve api",
    "build:all": "nx run-many --target=build --all",
    "build:client-libs": "nx run-many -t build -p web-config,web-core-common,web-core-http,web-core-platform,web-core-auth,web-core-testing,web-lib-admin,web-lib-customer,web-lib-partner,web-lib-public,web-ui --skip-nx-cache",
    "build:server-libs": "nx run-many -t build -p server-core,server-data-access,server-features,server-feature-appointment,server-feature-dashboard,server-feature-portfolio,server-feature-review,server-feature-salon,server-feature-salon-staff-request,server-feature-social,server-feature-theme,server-feature-user --skip-nx-cache",
    "build:prod": "nx run-many --target=build --all --configuration=production",
    "build:affected": "nx affected:build",
    "build:api": "nx build api",
    "build:app:customer": "nx build web-app-customer",
    "build:app:partner": "nx build web-app-partner",
    "build:app:admin": "nx build web-app-admin",
    "build:lib:public": "nx build web-lib-public",
    "build:lib:customer": "nx build web-lib-customer",
    "build:lib:partner": "nx build web-lib-partner",
    "build:lib:admin": "nx build web-lib-admin",
    "test:all": "nx run-many --target=test --all",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:affected": "nx affected:test",
    "test:coverage": "nx run-many --target=test --all --code-coverage",
    "test:app:customer": "nx test web-app-customer",
    "test:app:partner": "nx test web-app-partner",
    "test:app:admin": "nx test web-app-admin",
    "test:lib:public": "nx test web-lib-public",
    "test:lib:customer": "nx test web-lib-customer",
    "test:lib:partner": "nx test web-lib-partner",
    "test:lib:admin": "nx test web-lib-admin",
    "test:api": "nx test api",
    "test:server-feature-auth:ut": "nx test server-feature-auth --configuration=ut",
    "test:server-feature-auth:it": "nx test server-feature-auth --configuration=it",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "lint:affected": "nx affected:lint",
    "lint:app:customer": "nx lint web-app-customer",
    "lint:app:partner": "nx lint web-app-partner",
    "lint:app:admin": "nx lint web-app-admin",
    "lint:lib:public": "nx lint web-lib-public",
    "lint:lib:customer": "nx lint web-lib-customer",
    "lint:lib:partner": "nx lint web-lib-partner",
    "lint:lib:admin": "nx lint web-lib-admin",
    "lint:api": "nx lint api",
    "type-check": "nx run-many --target=type-check --all",
    "type-check:app:customer": "nx type-check web-app-customer",
    "type-check:app:partner": "nx type-check web-app-partner",
    "type-check:app:admin": "nx type-check web-app-admin",
    "type-check:lib:public": "nx type-check web-lib-public",
    "type-check:lib:customer": "nx type-check web-lib-customer",
    "type-check:lib:partner": "nx type-check web-lib-partner",
    "type-check:lib:admin": "nx type-check web-lib-admin",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "npx npm-check-updates -u",
    "deps:update": "npm run deps:check && npm install",
    "deps:audit": "npm audit",
    "deps:audit:fix": "npm audit fix",
    "nx:graph": "nx graph",
    "nx:reset": "nx reset",
    "nx:generate": "nx generate",
    "nx:migrate": "nx migrate",
    "nx:affected:apps": "nx affected:apps",
    "nx:affected:libs": "nx affected:libs",
    "nx:affected:build": "nx affected:build",
    "nx:affected:test": "nx affected:test",
    "nx:affected:lint": "nx affected:lint",
    "openapi:lint:auth": "redocly lint docs/specs/auth/API/openapi.yaml --config .redocly.yaml --max-problems=0",
    "openapi:check:auth": "tsx scripts/openapi-auth-check.ts"
  },
