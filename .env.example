# Environment variables for Beauty SaaS API
DATABASE_URL=postgres://beauty:beauty@localhost:5432/bsaas
JWT_SECRET=changeme
NODE_ENV=development
PORT=3000

# Email Configuration
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Beauty SaaS <your_email@example.com>"

# Application URLs (comma-separated for multiple frontends)
FRONTEND_URLS="http://localhost:4200,http://localhost:4201,http://localhost:4202"
API_URL=http://localhost:3000

# File Storage Paths (relative to project root by default)
UPLOAD_DIR=uploads
BASE_IMAGE_PATH="${UPLOAD_DIR}/salon/${salonId}"
PORTFOLIO_IMAGE_PATH="portfolio/${portfolioId}/images"
STAFF_IMAGE_PATH="staffs/${staffId}/images"

# For local development, you can use the following command to generate a secret:
# openssl rand -hex 32

# Application Encryption Key (must be 64 hex characters / 32 bytes)
ENCRYPTION_KEY=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:4200,http://localhost:4201,http://localhost:4202"

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100  # Max requests per window

# Auth cookies (domain for AT/RT/CSRF cookies)
AUTH_COOKIE_DOMAIN=

# Application name (used for WebAuthn RP name)
APP_NAME=CTHub BSAAS

# Redis URL (WebAuthn challenge store)
REDIS_URL=redis://localhost:6379/0

# WebAuthn challenge TTL (seconds)
WEB_AUTHN_CHALLENGE_TTL=300

# WebAuthn challenge store (redis|memory)
WEB_AUTHN_CHALLENGE_STORE=redis

# Auth token TTLs
# Access token (short-lived): e.g., 15m
JWT_EXPIRES_IN=15m
# Refresh token TTLs (persistent RT cookie / Stay signed in)
# Non-customer (default) TTL, e.g., 7d
REFRESH_TOKEN_EXPIRES_IN_DEFAULT=7d
# Customer TTL, e.g., 180d
REFRESH_TOKEN_EXPIRES_IN_CUSTOMER=180d

# OAuth adapter selection (dev|google|meta)
OAUTH_ADAPTER=dev
# Server-side OAuth state TTL (seconds)
OAUTH_STATE_TTL=600

# Google OAuth config
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Meta (Facebook) OAuth config
META_CLIENT_ID=
META_CLIENT_SECRET=
META_REDIRECT_URI=

# Rate limit configuration (server-side; defaults shown)
RATE_LIMIT_PASSWORD_RESET_LIMIT=5
RATE_LIMIT_PASSWORD_RESET_WINDOW=900
RATE_LIMIT_EMAIL_VERIFY_LIMIT=5
RATE_LIMIT_EMAIL_VERIFY_WINDOW=600
RATE_LIMIT_EMAIL_VERIFY_OTP_LIMIT=10
RATE_LIMIT_EMAIL_VERIFY_OTP_WINDOW=600

# SonarQube Configuration (Self-Hosted)
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

