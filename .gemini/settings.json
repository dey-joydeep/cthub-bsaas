{
  "mcpServers": {
    "drawio": {
      "command": "npx",
      "args": [
        "-y",
        "@drawio/mcp"
      ]
    },
    "chrome-devtools-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "prisma-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "prisma",
        "mcp",
        "--schema",
        "libs/server/data-access/prisma/schema.prisma"
      ],
      "env": {
        "DATABASE_URL": "postgresql://postgres:root@localhost:5432/bsaas"
      }
    },
    "nx-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "nx-mcp@latest"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://postgres:root@localhost:5432/bsaas"
      ]
    },
    "penpot_http": {
      "type": "http",
      "httpUrl": "${PENPOT_MCP_URL}"
    }
  }
}
