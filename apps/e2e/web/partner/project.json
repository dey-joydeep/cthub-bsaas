{
  "name": "web-partner-e2e",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/e2e/web/partner/src",
  "tags": ["type:e2e", "platform:web"],
  "implicitDependencies": ["web-app-partner"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "command": "echo Web Partner E2E: scaffolding in place; tests TBD"
          }
        ],
        "parallel": false
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "no-error-on-unmatched-pattern": true,
        "args": ["**/*.ts"]
      }
    }
  }
}
