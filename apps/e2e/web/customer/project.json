{
  "name": "web-customer-e2e",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/e2e/web/customer/src",
  "tags": ["type:e2e", "platform:web"],
  "implicitDependencies": ["web-app-customer"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/e2e/web/customer/playwright.config.ts"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p apps/e2e/web/customer/tsconfig.json --noEmit"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "no-error-on-unmatched-pattern": true,
        "args": ["**/*.ts"]
      }
    }
  }
}
