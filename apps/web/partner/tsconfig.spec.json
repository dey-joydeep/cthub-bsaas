{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "strict": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["es2022", "dom"],
    "isolatedModules": true,
    "useDefineForClassFields": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/setup-jest.ts",
    "jest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/test-utils.tsx",
    "src/**/test-utils.ts",
    "src/**/__mocks__/*.ts",
    "src/**/__tests__/*.ts"
  ],
  "files": ["src/setup-jest.ts"],
  "exclude": ["node_modules/jasmine", "node_modules/jasmine-core", "node_modules/@types/jasmine", "**/*.mjs"]
}
