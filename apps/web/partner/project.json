{
  "name": "web-app-partner",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/partner/src",
  "tags": ["platform:web", "scope:web", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/partner"
        },
        "index": "apps/web/partner/src/index.html",
        "polyfills": ["apps/web/partner/src/polyfills.ts"],
        "tsConfig": "apps/web/partner/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/partner/src/assets",
            "output": "/assets/"
          },
          {
            "glob": "favicon.ico",
            "input": "apps/web/partner/src",
            "output": "/"
          }
        ],
        "styles": ["libs/web/config/src/styles/styles.css", "apps/web/partner/src/styles.css"],
        "scripts": [],
        "browser": "apps/web/partner/src/main.ts"
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "libs/web/config/src/environments/partner/environment.ts",
              "with": "libs/web/config/src/environments/partner/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false
        }
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web-app-partner:build:development",
        "port": 4200,
        "host": "localhost"
      },
      "configurations": {
        "production": {
          "buildTarget": "web-app-partner:build:production"
        },
        "development": {
          "buildTarget": "web-app-partner:build:development"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "jest.config.ts",
        "passWithNoTests": true,
        "tsConfig": "apps/web/partner/tsconfig.spec.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["{projectRoot}/src/**/*.ts", "{projectRoot}/src/**/*.html"]
      }
    }
  }
}
