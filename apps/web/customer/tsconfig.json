{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "../../../dist/apps/web/customer",
        "baseUrl": ".",
        "paths": {
            "@env/*": ["src/environments/*"],
            "@app/*": ["src/app/*"],
            "@shared/*": ["../../../libs/shared/src/*"],
            "@cthub-bsaas/web-ui": ["../../../libs/web/ui/src/index.ts"],
            "@cthub-bsaas/web-ui/*": ["../../../libs/web/ui/src/*"],
            "@cthub-bsaas/web-public": ["../../../libs/web/public/src/index.ts"],
            "@cthub-bsaas/web-public/*": ["../../../libs/web/public/src/*"],
            "@cthub-bsaas/web-customer": ["../../../libs/web/customer/src/index.ts"],
            "@cthub-bsaas/web-customer/*": ["../../../libs/web/customer/src/*"],
            "@cthub-bsaas/web-customer/auth": ["../../../libs/web/customer/src/lib/features/auth/index.ts"],
            "@cthub-bsaas/shared": ["../../../libs/shared/src/index.ts"],
            "@cthub-bsaas/shared/models/*": ["../../../libs/shared/src/lib/models/*"],
            "@cthub-bsaas/shared/*": ["../../../libs/shared/src/*"],
            "@cthub-bsaas/web-config": ["../../../libs/web/config/src/index.ts"],
            "@cthub-bsaas/web-config/environments/*": ["../../../libs/web/config/src/environments/*"],
            "@cthub-bsaas/web-core/auth": ["../../../libs/web/core/auth/src/index.ts"],
            "@cthub-bsaas/web-core-auth": ["../../../libs/web/core/auth/src/index.ts"],
            "@cthub-bsaas/web-core/http": ["../../../libs/web/core/http/src/index.ts"],
            "@cthub-bsaas/web-core-http": ["../../../libs/web/core/http/src/index.ts"],
            "@cthub-bsaas/web-core/testing": ["../../../libs/web/core/testing/src/index.ts"],
            "@cthub-bsaas/web-core-common": ["../../../libs/web/core/common/src/index.ts"],
            "@cthub-bsaas/web-core-platform": ["../../../libs/web/core/platform/src/index.ts"],
            "chart.js/dist/types/utils": ["../../../node_modules/chart.js/dist/types/utils.d.ts"]
        },
        "types": ["node"],
        "esModuleInterop": true
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    }
}
