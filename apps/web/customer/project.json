{
  "name": "web-app-customer",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/customer/src",
  "i18n": {
    "sourceLocale": "en-US",
    "locales": {
      "bn": {
        "translation": "apps/web/customer/src/locale/messages.bn.xlf"
      },
      "ja": {
        "translation": "apps/web/customer/src/locale/messages.ja.xlf"
      }
    }
  },
  "tags": ["platform:web", "scope:web", "type:app"],
  "targets": {
    "build": {
      "executor": "@nx/angular:application",
      "outputs": ["{options.outputPath.base}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": {
          "base": "dist/apps/customer"
        },
        "index": "apps/web/customer/src/index.html",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/web/customer/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/customer/src/assets",
            "output": "/assets/"
          },
          {
            "glob": "favicon.ico",
            "input": "apps/web/customer/src",
            "output": "/"
          }
        ],
        "styles": [
          "libs/web/config/src/styles/material-theme.css",
          "libs/web/config/src/styles/styles.css",
          "apps/web/customer/src/styles.css"
        ],
        "scripts": [],
        "browser": "apps/web/customer/src/main.ts",
        "server": "apps/web/customer/src/main.server.ts",
        "prerender": false,
        "ssr": {
          "entry": "apps/web/customer/src/server.ts"
        }
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "fileReplacements": [
            {
              "replace": "libs/web/config/src/environments/customer/environment.ts",
              "with": "libs/web/config/src/environments/customer/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "sourceMap": true,
          "extractLicenses": false
        }
      }
    },
    "serve": {
      "executor": "@nx/angular:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web-app-customer:build:development",
        "port": 4200,
        "host": "localhost"
      },
      "configurations": {
        "production": {
          "buildTarget": "web-app-customer:build:production"
        },
        "development": {
          "buildTarget": "web-app-customer:build:development"
        }
      },
      "readyWhen": {
        "signal": true
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.js",
        "{workspaceRoot}/eslint.base.js",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/tools/eslint-rules/**/*"
      ],
      "options": {
        "args": ["src/**/*.ts", "src/**/*.html"]
      }
    },
    "extract-i18n": {
      "executor": "@nx/angular:extract-i18n",
      "options": {
        "buildTarget": "web-app-customer:build",
        "format": "xlf2",
        "outputPath": "apps/web/customer/src/locale",
        "outFile": "messages.xlf"
      }
    }
  }
}
